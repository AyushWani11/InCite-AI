# Copy to server/.env and fill in. Never commit .env (it is git-ignored).
# Start the server from the server/ folder (npm start / npm run dev):
# .env is loaded from the current working directory.

# MongoDB connection string. For local testing, use a separate database
# name from production, e.g. mongodb+srv://.../incite_dev
MONGODB_URI=

# Long random string used to sign login tokens. The server will not start
# without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

GEMINI_API_KEY=

PINECONE_API_KEY=
# The index must use integrated embedding (e.g. llama-text-embed-v2) with
# field map text -> "text": Pinecone embeds the text itself. Check yours with
#   node scripts/inspect-pinecone.js
PINECONE_INDEX_NAME=
# Each user's chunks live in the namespace "<prefix>-<userId>". Change the
# prefix (e.g. to v3) when re-indexing for a new embedding model.
PINECONE_NAMESPACE_PREFIX=v2

# "production" on the deployed server (Secure, cross-site login cookie and
# FRONTEND_URL for CORS). Leave unset for local development.
NODE_ENV=

# Deployed frontend origin allowed by CORS when NODE_ENV=production,
# e.g. https://in-cite-ai.vercel.app
FRONTEND_URL=
