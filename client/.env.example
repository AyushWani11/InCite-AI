# Copy to .env.local if you need to change these. Both are optional.

# Where `npm run dev` forwards /api requests. Default: http://localhost:5000
# API_PROXY_TARGET=http://localhost:5000

# Build-time override for the API URL the browser calls.
# Default: /api on the site's own domain, in dev and in production (Vite
# forwards it locally; client/vercel.json forwards it to Render on Vercel).
# Pointing this at another domain makes the login cookie a third-party
# cookie, which Safari on iPhone and other browsers block.
# VITE_API_BASE_URL=https://your-api.example.com/api
