{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{
			"source": "/api/:path*",
			"destination": "https://incite-ai-4vrv.onrender.com/api/:path*"
		},
		{ "source": "/(.*)", "destination": "/index.html" }
	],
	"headers": [
		{
			"source": "/api/:path*",
			"headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }]
		}
	]
}
